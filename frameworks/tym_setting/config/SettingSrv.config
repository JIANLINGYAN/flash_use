/* =====================================================================
 * TYM Setting 数据契约三表（精简演示版）
 *
 * 该文件被 #include 进 vendor/src/app_setting_idle_activity.c（非独立
 * 编译单元），依次定义四部分：
 *   ① 参数宏
 *   ② RAM 镜像结构 + 实例
 *   ③ ID → {指针, 尺寸, 属性} 静态表（须严格按枚举顺序）
 *   ④ Flash 布局：基址 + 字偏移 + ID→地址表
 *
 * 三表对齐规则（框架最大维护风险，靠 _Static_assert 编译期校验）：
 *   - settingDB 条目数必须 == SETID_MAX；
 *   - 总用量不得超过擦除块大小。
 * ===================================================================== */

/* ---- ① 参数宏 ---- */
#define PAGE_SIZE           (1024 * 8)
#define SETTING_SAVE_MS     5000
/* 启用 <4 字节项补齐分支（写 4 字节对齐），符合 NVM 驱动要求 */
#define SETT_ELEMENT_MIN_SIZE 4

/* ---- ② RAM 镜像结构 + 实例 ----
 * 注意：用固定宽度类型（uint32_t/int32_t/uint8_t）。原版 uint32/int32
 * 在 64 位主机为 unsigned long/signed long（8 字节），会导致 GetSize
 * 与 Flash 布局在模拟平台失真。 */
typedef struct tSettingEntry
{
    uint32_t masterVol;
    uint32_t audioGain1;
    uint32_t audioGain2;
    uint32_t audioGain3;
    uint8_t  factoryReset;
    uint8_t  OTAFlag;
    char     btName[24];   /* 名称缓冲：保持 4 字节对齐（20 字节名 + 4 字节保留） */
    int32_t  ch1SigLevel;
} tSettingEntry;

static tSettingEntry setting;

/* ---- ③ ID → {指针, 尺寸, 属性}（必须严格按枚举顺序） ---- */
static tSettingDatabase settingDB[SETID_MAX] =
{
    /* [0] SETID_MASTER_VOL */
    { &setting.masterVol, sizeof(setting.masterVol),
      SETTING_ATTR_VALID | SETTING_ATTR_NVM },
    /* [1] SETID_AUDIO_GAIN_1 */
    { &setting.audioGain1, sizeof(setting.audioGain1),
      SETTING_ATTR_VALID | SETTING_ATTR_NVM },
    /* [2] SETID_AUDIO_GAIN_2 */
    { &setting.audioGain2, sizeof(setting.audioGain2),
      SETTING_ATTR_VALID | SETTING_ATTR_NVM },
    /* [3] SETID_AUDIO_GAIN_3 */
    { &setting.audioGain3, sizeof(setting.audioGain3),
      SETTING_ATTR_VALID | SETTING_ATTR_NVM },
    /* [4] SETID_FACTORY_RESET */
    { &setting.factoryReset, sizeof(setting.factoryReset),
      SETTING_ATTR_VALID | SETTING_ATTR_NVM },
    /* [5] SETID_OTA_FLAG */
    { &setting.OTAFlag, sizeof(setting.OTAFlag),
      SETTING_ATTR_VALID | SETTING_ATTR_NVM },
    /* [6] SETID_BT_NAME */
    { &setting.btName, sizeof(setting.btName),
      SETTING_ATTR_VALID | SETTING_ATTR_NVM },
    /* [7] SETID_CH1_SIG_LEVEL（VALID 但非 NVM，不落 Flash） */
    { &setting.ch1SigLevel, sizeof(setting.ch1SigLevel),
      SETTING_ATTR_VALID },
};

/* 编译期三表校验（C99 兼容：typedef 数组技巧，条件为假则数组长度为负报错） */
#define TYM_STATIC_ASSERT(cond, name) \
    typedef char tym_static_assert_##name[(cond) ? 1 : -1]

TYM_STATIC_ASSERT(sizeof(settingDB) / sizeof(settingDB[0]) == SETID_MAX,
                  settingdb_count);

/* ---- ④ Flash 布局：基址 + 字偏移 + ID→地址表 ----
 * 基址须非 0（框架用 addr==0 表示"无 Flash 地址"，0 会被跳过）。
 * 模拟平台中该值为介质绝对偏移（分区起始偏移 + 数据区起始偏移）。 */
#define SETT_PAGE_ROM_ADDR    (1 * 4096)   /* 介质偏移 4096，避开 0 哨兵 */

#define OFFSET_MASTER_VOL        (0)
#define OFFSET_AUDIO_GAIN_1      (OFFSET_MASTER_VOL + 1)
#define OFFSET_AUDIO_GAIN_2      (OFFSET_AUDIO_GAIN_1 + 1)
#define OFFSET_AUDIO_GAIN_3      (OFFSET_AUDIO_GAIN_2 + 1)
#define OFFSET_FACTORY_RESET     (OFFSET_AUDIO_GAIN_3 + 1)   /* 1 字 = 4 字节（<4B 补齐写） */
#define OFFSET_OTA_FLAG          (OFFSET_FACTORY_RESET + 1)  /* 1 字 */
#define OFFSET_BT_NAME           (OFFSET_OTA_FLAG + 1)       /* 占 6 字 = 24 字节 */
#define OFFSET_LAST_ITEM         (OFFSET_BT_NAME + 6)        /* 末项结束位置 */

/* 总用量（字节）不得超过实际擦除块大小 */
#define SETT_TOTAL_BYTES         (OFFSET_LAST_ITEM * 4)
TYM_STATIC_ASSERT(SETT_TOTAL_BYTES <= (32 * 1024), region_size);

static const tSettingRomMap settingRomMap[] =
{
    { SETID_MASTER_VOL,   (SETT_PAGE_ROM_ADDR + OFFSET_MASTER_VOL * sizeof(uint32_t)) },
    { SETID_AUDIO_GAIN_1, (SETT_PAGE_ROM_ADDR + OFFSET_AUDIO_GAIN_1 * sizeof(uint32_t)) },
    { SETID_AUDIO_GAIN_2, (SETT_PAGE_ROM_ADDR + OFFSET_AUDIO_GAIN_2 * sizeof(uint32_t)) },
    { SETID_AUDIO_GAIN_3, (SETT_PAGE_ROM_ADDR + OFFSET_AUDIO_GAIN_3 * sizeof(uint32_t)) },
    { SETID_FACTORY_RESET,(SETT_PAGE_ROM_ADDR + OFFSET_FACTORY_RESET * sizeof(uint32_t)) },
    { SETID_OTA_FLAG,     (SETT_PAGE_ROM_ADDR + OFFSET_OTA_FLAG * sizeof(uint32_t)) },
    { SETID_BT_NAME,      (SETT_PAGE_ROM_ADDR + OFFSET_BT_NAME * sizeof(uint32_t)) },
};
